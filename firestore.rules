rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Teams Collection & Messages Subcollection
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();

      // Real-time Chat Messages Subcollection: teams/{teamId}/messages/{messageId}
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Team Members Collection: teamMembers/{teamId_userId}
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
  }
}
